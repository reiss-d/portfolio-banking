{
   "name": "banking-fraud-detection",
   "version": "0.0.0",
   "type": "module",
   "scripts": {
      "backend:dev": "cargo run -p backend",
      "backend:lint": "cargo clippy -p backend",
      "web:dev": "pnpm --filter web dev",
      "web:lint": "pnpm --filter web lint"
   },
   "devDependencies": {
      "@eslint/js": "catalog:",
      "@types/node": "catalog:",
      "eslint": "^10.14.0",
      "typescript": "catalog:",
      "typescript-eslint": "catalog:"
   },
   "packageManager": "pnpm@12.18.0",
   "devEngines": {
      "packageManager": {
         "name": "pnpm",
         "version": "^12.18.0",
         "onFail": "download"
      },
      "runtime": {
         "name": "node",
         "version": "^26.13.0",
         "onFail": "download"
      }
   }
}
